#: usr/lib/nvidia-prime-applet/nvidia-prime:16
msgid "NVIDIA (Performance Mode)"
msgstr "NVIDIA (Режим за перформанси)"

#: usr/lib/nvidia-prime-applet/nvidia-prime:17
msgid "NVIDIA On-Demand"
msgstr "NVIDIA на-барање"

#: usr/lib/nvidia-prime-applet/nvidia-prime:18
msgid "Intel (Power Saving Mode)"
msgstr "INTEL (режим за заштеда на енергија)"

#: usr/lib/nvidia-prime-applet/nvidia-prime:19
msgid "AMD (Power Saving Mode)"
msgstr "AMD (режим за заштеда на енергија)"

#: usr/lib/nvidia-prime-applet/nvidia-prime:61
#: usr/lib/nvidia-prime-applet/nvidia-prime:65
#: usr/lib/nvidia-prime-applet/nvidia-prime:68
#, python-format
msgid "Switch to: %s"
msgstr "Префрли на: %s"

#: usr/lib/nvidia-prime-applet/nvidia-prime:87
msgid "Unknown mode"
msgstr "Непознат режим"

#: usr/lib/nvidia-prime-applet/nvidia-prime:102
#, python-format
msgid "Active profile: %s"
msgstr "Активен профил: %s"

#: usr/lib/nvidia-prime-applet/nvidia-prime:114
#, python-format
msgid "Log out to switch to: %s"
msgstr "Одјави се за да се префрлиш на: %s"

#: usr/lib/nvidia-prime-applet/nvidia-prime:117
msgid "Cancel switch"
msgstr "Откажи префрлување"

#: usr/lib/nvidia-prime-applet/nvidia-prime:124
msgid "NVIDIA Settings"
msgstr "NVIDIA поставки"

#: usr/lib/nvidia-prime-applet/nvidia-prime:129
msgid "About"
msgstr "За"

#: usr/lib/nvidia-prime-applet/nvidia-prime:133
msgid "Quit"
msgstr "Откажи"

#: usr/lib/nvidia-prime-applet/nvidia-prime:169
#, python-format
msgid "Are you sure you want to cancel the switch and return to %s?"
msgstr ""
"Дали сте сигурни дека сакате да го откажете префрлувањето и да се вратите на "
"%s?"

#: usr/lib/nvidia-prime-applet/nvidia-prime:171
#, python-format
msgid "Are you sure you want to switch to %s?"
msgstr "Дали сте сигурни дека сакате да се префрлите на %s?"

#: usr/lib/nvidia-prime-applet/nvidia-prime:174
msgid "Changes will take effect after you log out and log back in."
msgstr ""
"Промените ќе стапат на сила откако ќе се одјавите и повторно ќе се најавите."
