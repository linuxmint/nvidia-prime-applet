#, python-format
msgid "Log out to switch to: %s"
msgstr "ອອກຈາກລະບົບເພື່ອປ່ຽນໄປທີ່: %s"

#: usr/lib/nvidia-prime-applet/nvidia-prime:134
msgid "Cancel switch"
msgstr "ຍົກເລີກການປ່ຽນ"

