#: usr/lib/nvidia-prime-applet/nvidia-prime:17
msgid "NVIDIA (Performance Mode)"
msgstr "NVIDIA (പ്രകടന മോഡ്)"

#: usr/lib/nvidia-prime-applet/nvidia-prime:18
msgid "NVIDIA On-Demand"
msgstr "എൻവിഡിയ ഓൺ-ഡിമാൻഡ്"

#: usr/lib/nvidia-prime-applet/nvidia-prime:19
msgid "Intel (Power Saving Mode)"
msgstr "ഇന്റൽ (പവർ സേവിംഗ് മോഡ്)"

#: usr/lib/nvidia-prime-applet/nvidia-prime:20
msgid "AMD (Power Saving Mode)"
msgstr "എഎംഡി (പവർ സേവിംഗ് മോഡ്)"

#: usr/lib/nvidia-prime-applet/nvidia-prime:75
#: usr/lib/nvidia-prime-applet/nvidia-prime:79
#: usr/lib/nvidia-prime-applet/nvidia-prime:82
#, python-format
msgid "Switch to: %s"
msgstr "ഇതിലേക്ക് മാറുക: %s"

#: usr/lib/nvidia-prime-applet/nvidia-prime:101
msgid "Unknown mode"
msgstr "അജ്ഞാത മോഡ്"

#: usr/lib/nvidia-prime-applet/nvidia-prime:116
#, python-format
msgid "Active profile: %s"
msgstr "സജീവ പ്രൊഫൈൽ: %s"

#: usr/lib/nvidia-prime-applet/nvidia-prime:129
#, python-format
msgid "Restart to switch to: %s"
msgstr ""

#: usr/lib/nvidia-prime-applet/nvidia-prime:131
#, python-format
msgid "Log out to switch to: %s"
msgstr "ഇതിലേക്ക് മാറാൻ ലോഗ് ഔട്ട് ചെയ്യുക: %s"

#: usr/lib/nvidia-prime-applet/nvidia-prime:134
msgid "Cancel switch"
msgstr "മാറ്റം റദ്ദാക്കുക"

#: usr/lib/nvidia-prime-applet/nvidia-prime:141
msgid "NVIDIA Settings"
msgstr "NVIDIA ക്രമീകരണങ്ങൾ"

#: usr/lib/nvidia-prime-applet/nvidia-prime:146
msgid "About"
msgstr "അതേക്കുറിച്ച് (About)"

#: usr/lib/nvidia-prime-applet/nvidia-prime:150
msgid "Quit"
msgstr "പുറത്ത് കടക്കുക (quit)"

#: usr/lib/nvidia-prime-applet/nvidia-prime:192
#, python-format
msgid "Are you sure you want to cancel the switch and return to %s?"
msgstr "മാറ്റം റദ്ദാക്കി %s ലേക്ക് തിരികെ പോകണമെന്ന് നിങ്ങൾക്ക് ഉറപ്പാണോ?"

#: usr/lib/nvidia-prime-applet/nvidia-prime:194
#, python-format
msgid "Are you sure you want to switch to %s?"
msgstr "%s ലേക്ക് മാറണമെന്ന് നിങ്ങൾക്ക് ഉറപ്പാണോ?"

#: usr/lib/nvidia-prime-applet/nvidia-prime:198
msgid "Changes will take effect after you restart the computer."
msgstr ""

#: usr/lib/nvidia-prime-applet/nvidia-prime:200
msgid "Changes will take effect after you log out and log back in."
msgstr ""
"നിങ്ങൾ ലോഗ് ഔട്ട് ചെയ്‌ത് വീണ്ടും ലോഗിൻ ചെയ്‌തതിനുശേഷം മാറ്റങ്ങൾ "
"പ്രാബല്യത്തിൽ വരും."
